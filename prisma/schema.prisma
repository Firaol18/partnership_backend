model Collaboration {
  id               String  @id @default(uuid()) @db.Uuid
  collaborationUid String  @unique @default(uuid()) @map("collaboration_uid") @db.Uuid
  collaborationId  String  @unique @map("collaboration_id") @db.VarChar(50) // COL-YYYY-XXXX

  // Links
  partnerId   String  @map("partner_id") @db.Uuid
  partner     Partner @relation("CollaborationPartner", fields: [partnerId], references: [id])

  agreementId String?    @map("agreement_id") @db.Uuid
  agreement   Agreement? @relation(fields: [agreementId], references: [id])

  // Information
  title             String  @db.VarChar(255)
  description       String? @db.Text
  collaborationType String  @map("collaboration_type") @db.VarChar(50)
  // Values: Joint Activity, Project, Resource Contribution, Funding and Grant

  // Timeline
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Status
  status String @default("Planned") @db.VarChar(50)
  // Values: Planned, Ongoing, Completed, Delayed, Cancelled

  // Workflow
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("CollaborationCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  activities JointActivity[]
  projects   Project[]
  resourceContributions ResourceContribution[]
  grants     FundingGrant[]

  @@index([collaborationId], map: "idx_collaborations_id")
  @@index([partnerId], map: "idx_collaborations_partner")
  @@index([agreementId], map: "idx_collaborations_agreement")
  @@index([collaborationType], map: "idx_collaborations_type")
  @@index([status], map: "idx_collaborations_status")
  @@index([startDate], map: "idx_collaborations_start_date")
  @@index([endDate], map: "idx_collaborations_end_date")
  @@map("collaborations")
}

model JointActivity {
  id          String  @id @default(uuid()) @db.Uuid
  activityUid String  @unique @default(uuid()) @map("activity_uid") @db.Uuid
  activityId  String  @unique @map("activity_id") @db.VarChar(50) // ACT-YYYY-XXXX

  // Links
  collaborationId String        @map("collaboration_id") @db.Uuid
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("ActivityPartner", fields: [partnerId], references: [id])

  // Activity Information
  activityName String  @map("activity_name") @db.VarChar(255)
  activityType String  @map("activity_type") @db.VarChar(100)
  // Values: Research, Training, Workshop, Conference, Field Work, Data Collection, Analysis, Publication, Other
  description  String? @db.Text

  // Timeline
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Responsibility
  leadOrganizationId   String  @map("lead_organization_id") @db.Uuid
  leadOrganization     Partner @relation("ActivityLeadOrganization", fields: [leadOrganizationId], references: [id])
  eaiiResponsibleUnit  String  @map("eaii_responsible_unit") @db.VarChar(255)
  partnerResponsibleUnit String? @map("partner_responsible_unit") @db.VarChar(255)

  // Outputs (JSON for summary, ActivityOutput for itemized)
  plannedOutputs Json? @map("planned_outputs")
  actualOutputs  Json? @map("actual_outputs")

  // Approval
  approvalStatus String    @default("pending") @map("approval_status") @db.VarChar(20)
  approvalReason String?   @map("approval_reason") @db.Text
  approvedById   String?   @map("approved_by") @db.Uuid
  approvedBy     User?     @relation("ActivityApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime? @map("approved_at")

  // Review
  reviewedById       String?   @map("reviewed_by") @db.Uuid
  reviewer           User?     @relation("ActivityReviewer", fields: [reviewedById], references: [id])
  reviewNotes        String?   @map("review_notes") @db.Text
  reviewDate         DateTime? @map("review_date")

  // Verification
  verifiedById       String?   @map("verified_by") @db.Uuid
  verifier           User?     @relation("ActivityVerifier", fields: [verifiedById], references: [id])
  verificationNotes  String?   @map("verification_notes") @db.Text
  verificationDate   DateTime? @map("verification_date")
  verifiedStatus     String    @default("pending") @map("verified_status") @db.VarChar(20)

  // Status
  status String @default("Planned") @db.VarChar(50)
  // Values: Planned, Ongoing, Completed, Delayed, Cancelled

  // Workflow
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ActivityCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  outputs ActivityOutput[]

  @@index([activityId], map: "idx_joint_activities_id")
  @@index([collaborationId], map: "idx_joint_activities_collaboration")
  @@index([partnerId], map: "idx_joint_activities_partner")
  @@index([activityType], map: "idx_joint_activities_type")
  @@index([status], map: "idx_joint_activities_status")
  @@index([approvalStatus], map: "idx_joint_activities_approval")
  @@index([startDate], map: "idx_joint_activities_start_date")
  @@index([endDate], map: "idx_joint_activities_end_date")
  @@map("joint_activities")
}

model ActivityOutput {
  id        String @id @default(uuid()) @db.Uuid
  outputUid String @unique @default(uuid()) @map("output_uid") @db.Uuid

  activityId String        @map("activity_id") @db.Uuid
  activity   JointActivity @relation(fields: [activityId], references: [id])

  outputType        String  @map("output_type") @db.VarChar(20)
  // Values: planned, actual
  outputDescription String  @map("output_description") @db.Text
  quantity          Int?
  unit              String? @db.VarChar(50)
  completionDate    DateTime? @map("completion_date") @db.Date

  status String @default("pending") @db.VarChar(20)
  // Values: pending, completed, delayed, cancelled

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([activityId], map: "idx_activity_outputs_activity")
  @@index([outputType], map: "idx_activity_outputs_type")
  @@index([status], map: "idx_activity_outputs_status")
  @@map("activity_outputs")
}

model Project {
  id         String @id @default(uuid()) @db.Uuid
  projectUid String @unique @default(uuid()) @map("project_uid") @db.Uuid
  projectId  String @unique @map("project_id") @db.VarChar(50) // PRJ-YYYY-XXXX

  // Links
  collaborationId String        @map("collaboration_id") @db.Uuid
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("ProjectPartner", fields: [partnerId], references: [id])

  // Project Details
  projectName  String  @map("project_name") @db.VarChar(255)
  description  String? @db.Text
  thematicArea String? @map("thematic_area") @db.VarChar(100)
  // Values: AI Research, AI Infrastructure, AI Capacity Building, Startup Ecosystem, Digital Transformation, AI Governance, Data Science, Innovation, Other

  // Funding
  budget        Decimal? @db.Decimal(15, 2)
  fundingSource String?  @map("funding_source") @db.VarChar(255)
  currency      String?  @db.VarChar(3) // ETB, USD, EUR, etc.

  // Team
  projectManager String? @map("project_manager") @db.VarChar(255)
  partnerLead    String? @map("partner_lead") @db.VarChar(255)
  teamMembers    Json?   @map("team_members") // Array of {name, role, organization}

  // Timeline
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  // Progress summaries (JSON snapshots as requested in DBML)
  percentageCompletion Decimal? @default(0.00) @map("percentage_completion") @db.Decimal(5, 2)
  milestonesSummary    Json?    @map("milestones") // Array of {name, due_date, status}
  deliverablesSummary  Json?    @map("deliverables") // Array of {name, description, status}
  risksSummary         Json?    @map("risks") // Array of {description, mitigation, status}

  // Status
  status String @default("Planned") @db.VarChar(50)
  // Values: Planned, Ongoing, Completed, Delayed, Cancelled

  // Approval
  approvalStatus String    @default("pending") @map("approval_status") @db.VarChar(20)
  approvalReason String?   @map("approval_reason") @db.Text
  approvedById   String?   @map("approved_by") @db.Uuid
  approvedBy     User?     @relation("ProjectApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime? @map("approved_at")

  // Workflow
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Detailed lists
  detailedMilestones  ProjectMilestone[]
  detailedDeliverables ProjectDeliverable[]
  detailedRisks        ProjectRisk[]
  resourceContributions ResourceContribution[]
  grants                FundingGrant[]

  @@index([projectId], map: "idx_projects_id")
  @@index([collaborationId], map: "idx_projects_collaboration")
  @@index([partnerId], map: "idx_projects_partner")
  @@index([thematicArea], map: "idx_projects_thematic_area")
  @@index([status], map: "idx_projects_status")
  @@index([approvalStatus], map: "idx_projects_approval")
  @@index([startDate], map: "idx_projects_start_date")
  @@index([endDate], map: "idx_projects_end_date")
  @@map("projects")
}

model ProjectMilestone {
  id           String @id @default(uuid()) @db.Uuid
  milestoneUid String @unique @default(uuid()) @map("milestone_uid") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  milestoneName      String    @map("milestone_name") @db.VarChar(255)
  description        String?   @db.Text
  dueDate            DateTime  @map("due_date") @db.Date
  completionDate     DateTime? @map("completion_date") @db.Date
  status             String    @default("pending") @db.VarChar(20)
  // Values: pending, in_progress, completed, delayed, cancelled
  percentageComplete Decimal   @default(0.00) @map("percentage_complete") @db.Decimal(5, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId], map: "idx_milestones_project")
  @@index([status], map: "idx_milestones_status")
  @@index([dueDate], map: "idx_milestones_due_date")
  @@map("project_milestones")
}

model ProjectDeliverable {
  id             String @id @default(uuid()) @db.Uuid
  deliverableUid String @unique @default(uuid()) @map("deliverable_uid") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  deliverableName String    @map("deliverable_name") @db.VarChar(255)
  description     String?   @db.Text
  expectedDate    DateTime? @map("expected_date") @db.Date
  deliveredDate   DateTime? @map("delivered_date") @db.Date
  status          String    @default("pending") @db.VarChar(20)
  // Values: pending, in_progress, completed, delayed, cancelled

  documentId String?   @map("document_id") @db.Uuid
  document   Document? @relation(fields: [documentId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId], map: "idx_deliverables_project")
  @@index([status], map: "idx_deliverables_status")
  @@index([documentId], map: "idx_deliverables_document")
  @@map("project_deliverables")
}

model ProjectRisk {
  id      String @id @default(uuid()) @db.Uuid
  riskUid String @unique @default(uuid()) @map("risk_uid") @db.Uuid

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id])

  riskDescription String  @map("risk_description") @db.Text
  mitigationPlan  String? @map("mitigation_plan") @db.Text
  likelihood      String? @db.VarChar(20) // High, Medium, Low
  impact          String? @db.VarChar(20) // High, Medium, Low
  status          String  @default("open") @db.VarChar(20)
  // Values: open, mitigating, resolved, closed

  ownerId        String?   @map("owner_id") @db.Uuid
  owner          User?     @relation("RiskOwner", fields: [ownerId], references: [id])
  identifiedDate DateTime  @map("identified_date") @db.Date
  resolvedDate   DateTime? @map("resolved_date") @db.Date

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([projectId], map: "idx_project_risks_project")
  @@index([status], map: "idx_project_risks_status")
  @@index([ownerId], map: "idx_project_risks_owner")
  @@map("project_risks")
}

model ResourceContribution {
  id          String @id @default(uuid()) @db.Uuid
  resourceUid String @unique @default(uuid()) @map("resource_uid") @db.Uuid
  resourceId  String @unique @map("resource_id") @db.VarChar(50) // RES-YYYY-XXXX

  // Links
  collaborationId String        @map("collaboration_id") @db.Uuid
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("ResourcePartner", fields: [partnerId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  // EAII Contribution
  eaiiStaff          String?  @map("eaii_staff") @db.Text
  eaiiInfrastructure String?  @map("eaii_infrastructure") @db.Text
  eaiiFunding        Decimal? @map("eaii_funding") @db.Decimal(15, 2)
  eaiiEquipment      String?  @map("eaii_equipment") @db.Text
  eaiiDataResources  String?  @map("eaii_data_resources") @db.Text

  // Partner Contribution
  partnerStaff      String?  @map("partner_staff") @db.Text
  partnerFunding    Decimal? @map("partner_funding") @db.Decimal(15, 2)
  partnerTechnology String?  @map("partner_technology") @db.Text
  partnerEquipment  String?  @map("partner_equipment") @db.Text
  partnerExpertise  String?  @map("partner_expertise") @db.Text

  // Estimated Value
  estimatedMonetaryValue Decimal? @map("estimated_monetary_value") @db.Decimal(15, 2)
  estimatedInKindValue   Decimal? @map("estimated_in_kind_value") @db.Decimal(15, 2)
  currency               String?  @db.VarChar(3) // ETB, USD, EUR, etc.

  // Status
  status String @default("Active") @db.VarChar(50)
  // Values: Active, Completed, Cancelled

  // Workflow
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ResourceCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  grants FundingGrant[]

  @@index([resourceId], map: "idx_resources_id")
  @@index([collaborationId], map: "idx_resources_collaboration")
  @@index([partnerId], map: "idx_resources_partner")
  @@index([projectId], map: "idx_resources_project")
  @@index([status], map: "idx_resources_status")
  @@map("resource_contributions")
}

model FundingGrant {
  id       String @id @default(uuid()) @db.Uuid
  grantUid String @unique @default(uuid()) @map("grant_uid") @db.Uuid
  grantId  String @unique @map("grant_id") @db.VarChar(50) // GRT-YYYY-XXXX

  // Links
  collaborationId String        @map("collaboration_id") @db.Uuid
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id])

  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("GrantPartner", fields: [partnerId], references: [id]) // Donor organization

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  resourceContributionId String?               @map("resource_contribution_id") @db.Uuid
  resourceContribution   ResourceContribution? @relation(fields: [resourceContributionId], references: [id])

  // Grant Information
  donorName String  @map("donor_name") @db.VarChar(255)
  amount    Decimal @db.Decimal(15, 2)
  currency  String  @db.VarChar(3) // ETB, USD, EUR, etc.

  // Timeline
  submissionDate DateTime? @map("submission_date") @db.Date
  approvalDate   DateTime? @map("approval_date") @db.Date
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date

  // Status
  status String @default("Concept") @db.VarChar(50)
  // Values: Concept, Submitted, Under Review, Approved, Rejected, Completed, Disbursed

  // Additional Fields
  grantReferenceNumber String? @map("grant_reference_number") @db.VarChar(100)
  description          String? @db.Text
  disbursementSchedule Json?   @map("disbursement_schedule") // Array of disbursement details

  // Workflow
  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("GrantCreator", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  disbursements GrantDisbursement[]

  @@index([grantId], map: "idx_grants_id")
  @@index([collaborationId], map: "idx_grants_collaboration")
  @@index([partnerId], map: "idx_grants_partner")
  @@index([projectId], map: "idx_grants_project")
  @@index([resourceContributionId], map: "idx_grants_resource")
  @@index([status], map: "idx_grants_status")
  @@index([donorName], map: "idx_grants_donor")
  @@index([submissionDate], map: "idx_grants_submission_date")
  @@index([approvalDate], map: "idx_grants_approval_date")
  @@index([endDate], map: "idx_grants_end_date")
  @@map("funding_grants")
}

model GrantDisbursement {
  id              String @id @default(uuid()) @db.Uuid
  disbursementUid String @unique @default(uuid()) @map("disbursement_uid") @db.Uuid

  grantId String       @map("grant_id") @db.Uuid
  grant   FundingGrant @relation(fields: [grantId], references: [id])

  disbursementDate DateTime @map("disbursement_date") @db.Date
  amount           Decimal  @db.Decimal(15, 2)
  currency         String   @db.VarChar(3) // ETB, USD, EUR, etc.
  description      String?  @db.Text
  referenceNumber  String?  @map("reference_number") @db.VarChar(100)
  status           String   @default("pending") @db.VarChar(20)
  // Values: pending, disbursed, cancelled

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([grantId], map: "idx_disbursements_grant")
  @@index([disbursementDate], map: "idx_disbursements_date")
  @@index([status], map: "idx_disbursements_status")
  @@map("grant_disbursements")
}

model CollaborationDocument {
  id         String @id @default(uuid()) @db.Uuid
  entityType String @map("entity_type") @db.VarChar(20) // activity, project, resource, grant
  entityId   String @map("entity_id") @db.Uuid // string (UUID key of entity)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])

  documentCategory String @map("document_category") @db.VarChar(50)
  // Values: Plan, Report, Output, Presentation, Budget, Contract, Other

  isCurrent Boolean @default(true) @map("is_current")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([entityType, entityId, documentId], map: "idx_collab_doc_unique")
  @@index([entityType, entityId], map: "idx_collab_doc_entity")
  @@index([documentId], map: "idx_collab_doc_document")
  @@index([documentCategory], map: "idx_collab_doc_category")
  @@index([isCurrent], map: "idx_collab_doc_current")
  @@map("collaboration_documents")
}

model ActivityApprovalHistory {
  id         String @id @default(uuid()) @db.Uuid
  entityType String @map("entity_type") @db.VarChar(20) // activity, project
  entityId   String @map("entity_id") @db.Uuid

  action   String @db.VarChar(20)
  // Values: submitted, reviewed, verified, approved, rejected

  actionById String @map("action_by") @db.Uuid
  actionBy   User   @relation("ApprovalHistoryUser", fields: [actionById], references: [id])

  actionDate DateTime @map("action_date") @default(now())
  notes      String?  @db.Text
  reason     String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId], map: "idx_act_approval_entity")
  @@index([actionById], map: "idx_act_approval_user")
  @@index([actionDate], map: "idx_act_approval_date")
  @@index([action], map: "idx_act_approval_action")
  @@map("activity_approval_history")
}


