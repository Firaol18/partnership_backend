model Engagement {
  id            String @id @default(uuid()) @db.Uuid
  engagementUid String @unique @default(uuid()) @map("engagement_uid") @db.Uuid
  recordId      String @unique @map("record_id") @db.VarChar(50)

  opportunityId String             @map("opportunity_id") @db.Uuid
  opportunity   PartnerOpportunity @relation(fields: [opportunityId], references: [id])

  engagementTypeId String         @map("engagement_type_id") @db.Uuid
  engagementType   EngagementType @relation(fields: [engagementTypeId], references: [id])

  engagementDate DateTime  @map("engagement_date") @db.Date
  title          String    @db.VarChar(255)
  location       String?   @db.VarChar(255)
  startTime      DateTime? @map("start_time") @db.Time
  endTime        DateTime? @map("end_time") @db.Time

  // Discussion Summary
  keyPoints     String @map("key_points") @db.Text
  agreedActions String @map("agreed_actions") @db.Text
  nextSteps     String @map("next_steps") @db.Text

  // Follow-up Tracking
  followUpRequired Boolean   @default(false) @map("follow_up_required")
  followUpDate     DateTime? @map("follow_up_date") @db.Date
  followUpNotes    String?   @map("follow_up_notes") @db.Text

  status String @default("Draft") @db.VarChar(50)

  // Workflow
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("EngagementCreator", fields: [createdBy], references: [id])

  approvedBy    String?   @map("approved_by") @db.Uuid
  approver      User?     @relation("EngagementApprover", fields: [approvedBy], references: [id])
