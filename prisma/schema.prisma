  reviewNotes  String?   @map("review_notes") @db.Text
  reviewStatus String    @map("review_status") @db.VarChar(20)
  reviewDate   DateTime  @map("review_date")

  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([agreementId], map: "idx_agr_review_agreement")
  @@index([reviewerId], map: "idx_agr_review_reviewer")
  @@index([reviewType], map: "idx_agr_review_type")
  @@index([reviewDate], map: "idx_agr_review_date")
  @@map("agreement_review_history")
