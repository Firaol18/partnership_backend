model Partner {
  id         String @id @default(uuid()) @db.Uuid
  partnerUid String @unique @default(uuid()) @map("partner_uid") @db.Uuid
  partnerId  String @unique @map("partner_id") @db.VarChar(50)

  // Registration Path
  registrationPath String @map("registration_path") @db.VarChar(10) // FORMAL | DIRECT

  // PATH A: Formal process links
  agreementId   String? @map("agreement_id") @db.Uuid
  agreement     Agreement? @relation(fields: [agreementId], references: [id])

  opportunityId String? @map("opportunity_id") @db.Uuid
  opportunity   PartnerOpportunity? @relation("PartnerFromOpportunity", fields: [opportunityId], references: [id])

  engagementId  String? @map("engagement_id") @db.Uuid
  engagement    Engagement? @relation("PartnerFromEngagement", fields: [engagementId], references: [id])

  // Basic Information
  partnerName               String   @map("partner_name") @db.VarChar(255)
  acronym                   String?  @db.VarChar(50)
  organizationTypeId        String?  @map("organization_type_id") @db.Uuid
  organizationType          OrganizationType? @relation(fields: [organizationTypeId], references: [id])
  country                   String   @db.VarChar(100)
  regionState               String?  @map("region_state") @db.VarChar(100)
  city                      String?  @db.VarChar(100)
  address                   String?  @db.Text
  website                   String?  @db.VarChar(255)
  yearEstablished           Int?     @map("year_established")
  registrationLicenseNumber String?  @map("registration_license_number") @db.VarChar(100)
  taxNumber                 String?  @map("tax_number") @db.VarChar(50)
  logoUrl                   String?  @map("logo_url") @db.Text

  // Organization Details
  mission                  String?  @db.Text
  vision                   String?  @db.Text
  strategicFocusAreas      String?  @map("strategic_focus_areas") @db.Text
  keyExpertiseAreas        String?  @map("key_expertise_areas") @db.Text
  aiFocusAreas             String?  @map("ai_focus_areas") @db.Text
  annualBudget             Decimal? @map("annual_budget") @db.Decimal(15, 2)
  numberOfEmployees        Int?     @map("number_of_employees")
  geographicCoverage       String?  @map("geographic_coverage") @db.Text
  partnerClassificationId  String?  @map("partner_classification_id") @db.Uuid
  partnerClassification    PartnerClassification? @relation(fields: [partnerClassificationId], references: [id])

  // Status
  statusId  String      @map("status_id") @db.Uuid
  status    PartnerStatus @relation(fields: [statusId], references: [id])

  // Workflow
  createdById        String   @map("created_by") @db.Uuid
  createdBy          User     @relation("PartnerCreator", fields: [createdById], references: [id])

  reviewedById       String?  @map("reviewed_by") @db.Uuid
  reviewer           User?    @relation("PartnerReviewer", fields: [reviewedById], references: [id])
  reviewNotes        String?  @map("review_notes") @db.Text
  reviewDate         DateTime? @map("review_date")

  verifiedById       String?  @map("verified_by") @db.Uuid
  verifier           User?    @relation("PartnerVerifier", fields: [verifiedById], references: [id])
  verificationNotes  String?  @map("verification_notes") @db.Text
  verificationDate   DateTime? @map("verification_date")
  verifiedStatus     String   @default("pending") @map("verified_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  contacts      PartnerContact[]
  focalPersons  InternalFocalPerson[]

  // Collaboration relations
  collaborations       Collaboration[]  @relation("CollaborationPartner")
  collaborationLeads   JointActivity[]  @relation("ActivityLeadOrganization")
  activities           JointActivity[]  @relation("ActivityPartner")
  projects             Project[]        @relation("ProjectPartner")
  resourceContributions ResourceContribution[] @relation("ResourcePartner")
  grants               FundingGrant[]   @relation("GrantPartner")

  @@index([partnerName], map: "idx_partners_name")
  @@index([country], map: "idx_partners_country")
  @@index([statusId], map: "idx_partners_status")
  @@index([organizationTypeId], map: "idx_partners_org_type")
  @@index([agreementId], map: "idx_partners_agreement")
