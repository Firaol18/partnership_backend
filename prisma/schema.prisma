  @@index([recordId], map: "idx_engagements_record_id")
  @@index([opportunityId], map: "idx_engagements_opportunity")
  @@index([engagementDate], map: "idx_engagements_date")
  @@index([engagementTypeId], map: "idx_engagements_type")
  @@index([status], map: "idx_engagements_status")
  @@index([createdBy], map: "idx_engagements_creator")
  @@map("engagements")
