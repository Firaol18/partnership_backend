generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String?

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name], map: "idx_roles_name")
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  resource String @db.VarChar(100)
  action   String @db.VarChar(50)

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @db.Uuid
  permissionId String @db.Uuid

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  roleId String @db.Uuid

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId], map: "idx_user_roles_user")
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
}

model Division {
  id String @id @default(uuid()) @db.Uuid

  name String @unique @db.VarChar(100)

  directorId String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  director User? @relation("DivisionDirector", fields: [directorId], references: [id])

  users User[]

  @@index([name], map: "idx_divisions_name")
  @@index([directorId], map: "idx_divisions_director")
  @@map("divisions")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  fullName       String  @db.VarChar(150)
  email          String  @unique @db.VarChar(150)
  passwordHash   String  @db.VarChar(255)
  phone          String? @db.VarChar(20)
  profilePicture String?
  position       String? @db.VarChar(100)

  divisionId           String?   @db.Uuid
  directorate          String?   @db.VarChar(100)
  status               String    @default("ACTIVE") @db.VarChar(30)
  tokenVersion         Int       @default(0)
  loginAttempts        Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?   @db.VarChar(45)
  lastLoginUserAgent   String?
  lastPasswordChangeAt DateTime?
  passwordExpiresAt    DateTime?
  mustChangePassword   Boolean   @default(false)
  isEmailVerified      Boolean   @default(true)
  emailVerifiedAt      DateTime?
  failedLoginAt        DateTime?
  refreshTokenHash     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  division Division? @relation(fields: [divisionId], references: [id])

  directedDivisions Division[] @relation("DivisionDirector")

  userRoles UserRole[]

  activityLogs UserActivityLog[]

  // Document relations - using different relation names to avoid conflicts
  uploadedDocuments Document[] @relation("DocumentUploader")
  updatedDocuments  Document[] @relation("DocumentUpdater")

  // Visit relations
  focalPersonVisits Visit[] @relation("VisitFocalPerson")
  createdVisits     Visit[] @relation("VisitCreator")
  reviewedVisits    Visit[] @relation("VisitReviewer")
  verifiedVisits    Visit[] @relation("VisitVerifier")

  // Event relations
  createdEvents  Event[] @relation("EventCreator")
  reviewedEvents Event[] @relation("EventReviewer")
  verifiedEvents Event[] @relation("EventVerifier")

  eventEaiiParticipants EventEaiiParticipant[]
  partnerOpportunities  PartnerOpportunity[]

  // Opportunity relations
  createdOpportunities      PartnerOpportunity[]       @relation("OpportunityCreator")
  reviewedOpportunities     PartnerOpportunity[]       @relation("OpportunityReviewer")
  verifiedOpportunities     PartnerOpportunity[]       @relation("OpportunityVerifier")
  opportunityCommunications OpportunityCommunication[]
  engagements               Engagement[]

  // Engagement relations
  engagementEaiiRepresentatives EngagementEaiiRepresentative[]
  sentCommunications            OpportunityCommunication[]     @relation("CommunicationSender")
  createdEngagements            Engagement[]                   @relation("EngagementCreator")
  approvedEngagements           Engagement[]                   @relation("EngagementApprover")

  @@index([email], map: "idx_users_email")
  @@index([status], map: "idx_users_status")
  @@index([divisionId], map: "idx_users_division")
  @@map("users")
}

model UserActivityLog {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid

  action String @db.VarChar(50)

  entityType String @db.VarChar(50)

  entityId String

  oldValues Json?

  newValues Json?

  ipAddress Unsupported("inet")?

  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_activity_user")
  @@index([createdAt], map: "idx_activity_created")
  @@map("user_activity_logs")
}

model DocumentType {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  documents Document[]

  @@map("document_types")
}

model Document {
  id           String @id @default(uuid()) @db.Uuid
  documentUid  String @unique @default(uuid()) @map("document_uid") @db.Uuid
  documentName String @map("document_name") @db.VarChar(255)

  documentTypeId String       @map("document_type_id") @db.Uuid
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  description String? @db.Text
  fileName    String  @map("file_name") @db.VarChar(255)
  filePath    String  @map("file_path") @db.Text
  fileSize    BigInt? @map("file_size")
  fileFormat  String? @map("file_format") @db.VarChar(20)
  mimeType    String? @map("mime_type") @db.VarChar(100)

  version           String?    @default("1.0") @db.VarChar(20)
  isLatestVersion   Boolean    @default(true) @map("is_latest_version")
  previousVersionId String?    @map("previous_version_id") @db.Uuid
  previousVersion   Document?  @relation("DocumentVersions", fields: [previousVersionId], references: [id])
  nextVersions      Document[] @relation("DocumentVersions")

  entityType String? @map("entity_type") @db.VarChar(50)
  entityId   String? @map("entity_id") @db.Uuid

  isPublic         Boolean   @default(false) @map("is_public")
  accessLevel      String    @default("internal") @map("access_level") @db.VarChar(20)
  accessExpiryDate DateTime? @map("access_expiry_date")
  downloadedCount  Int       @default(0) @map("downloaded_count")

  status String @default("Active") @db.VarChar(50)

  uploadedBy String @map("uploaded_by") @db.Uuid
  uploader   User   @relation("DocumentUploader", fields: [uploadedBy], references: [id])

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  updatedBy String? @map("updated_by") @db.Uuid
  updater   User?   @relation("DocumentUpdater", fields: [updatedBy], references: [id])

  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tags DocumentTag[]

  @@index([isLatestVersion], map: "idx_docs_latest")
  @@index([status], map: "idx_docs_status")
  @@index([documentTypeId], map: "idx_docs_type")
  @@index([uploadedBy], map: "idx_docs_uploader")
  @@map("documents")
}

model DocumentTag {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])
  tagName    String   @map("tag_name") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([documentId, tagName])
  @@index([documentId], map: "idx_doc_tags_doc")
  @@index([tagName], map: "idx_doc_tags_name")
  @@map("document_tags")
}

model EventType {
  id          String  @id @default(uuid()) @db.Uuid
  typeName    String  @unique @map("type_name") @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events Event[]

  @@index([typeName], map: "idx_event_types_name")
  @@map("event_types")
}

model EventCategory {
  id           String  @id @default(uuid()) @db.Uuid
  categoryName String  @unique @map("category_name") @db.VarChar(50)
  description  String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events Event[]

  @@index([categoryName], map: "idx_event_categories_name")
  @@map("event_categories")
}

model EventMode {
  id          String  @id @default(uuid()) @db.Uuid
  modeName    String  @unique @map("mode_name") @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  events Event[]

  @@map("event_modes")
}

model Event {
  id        String @id @default(uuid()) @db.Uuid
  eventUid  String @unique @default(uuid()) @map("event_uid") @db.Uuid
  recordId  String @unique @map("record_id") @db.VarChar(50)
  title     String @db.VarChar(255)
  eventName String @map("event_name") @db.VarChar(255)

  eventTypeId String    @map("event_type_id") @db.Uuid
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  eventCategoryId String        @map("event_category_id") @db.Uuid
  eventCategory   EventCategory @relation(fields: [eventCategoryId], references: [id])

  eventDate DateTime @map("event_date") @db.Date
  startTime DateTime @map("start_time") @db.Time
  endTime   DateTime @map("end_time") @db.Time

  venue       String  @db.VarChar(255)
  organizer   String? @db.VarChar(255)
  coOrganizer String? @map("co_organizer") @db.VarChar(255)

  eventModeId String    @map("event_mode_id") @db.Uuid
  eventMode   EventMode @relation(fields: [eventModeId], references: [id])

  partnerId String? @map("partner_id") @db.Uuid

  status String @default("Planned") @db.VarChar(50)

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("EventCreator", fields: [createdBy], references: [id])

  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewer    User?     @relation("EventReviewer", fields: [reviewedBy], references: [id])
  reviewNotes String?   @map("review_notes") @db.Text
  reviewDate  DateTime? @map("review_date")

  verifiedBy        String?   @map("verified_by") @db.Uuid
  verifier          User?     @relation("EventVerifier", fields: [verifiedBy], references: [id])
  verificationNotes String?   @map("verification_notes") @db.Text
  verificationDate  DateTime? @map("verification_date")
  verifiedStatus    String    @default("pending") @map("verified_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  participants     EventParticipant[]
  eaiiParticipants EventEaiiParticipant[]
  budgets          EventBudget[]
  outcomes         EventOutcome[]

  @@index([recordId], map: "idx_events_record_id")
  @@index([eventName], map: "idx_events_name")
  @@index([eventDate], map: "idx_events_date")
  @@index([eventTypeId], map: "idx_events_type")
  @@index([eventCategoryId], map: "idx_events_category")
  @@index([partnerId], map: "idx_events_partner")
  @@index([status], map: "idx_events_status")
  @@index([createdBy], map: "idx_events_creator")
  @@map("events")
}

model EventParticipant {
  id             String @id @default(uuid()) @db.Uuid
  participantUid String @unique @default(uuid()) @map("participant_uid") @db.Uuid

  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])

  fullName         String  @map("full_name") @db.VarChar(255)
  organizationName String  @map("organization_name") @db.VarChar(255)
  position         String? @db.VarChar(255)
  email            String  @db.VarChar(255)
  phoneNumber      String? @map("phone_number") @db.VarChar(50)
  participantType  String? @map("participant_type") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId], map: "idx_event_participants_event")
  @@index([email], map: "idx_event_participants_email")
  @@index([organizationName], map: "idx_event_participants_org")
  @@map("event_participants")
}

model EventEaiiParticipant {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id])
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([eventId, userId])
  @@index([eventId], map: "idx_event_eaii_event")
  @@index([userId], map: "idx_event_eaii_user")
  @@map("event_eaii_participants")
}

model EventBudget {
  id        String @id @default(uuid()) @db.Uuid
  budgetUid String @unique @default(uuid()) @map("budget_uid") @db.Uuid
  eventId   String @map("event_id") @db.Uuid
  event     Event  @relation(fields: [eventId], references: [id])

  estimatedBudget Decimal? @map("estimated_budget") @db.Decimal(15, 2)
  actualBudget    Decimal? @map("actual_budget") @db.Decimal(15, 2)
  fundingSource   String?  @map("funding_source") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId], map: "idx_event_budget_event")
  @@map("event_budget")
}

model EventOutcome {
  id         String @id @default(uuid()) @db.Uuid
  outcomeUid String @unique @default(uuid()) @map("outcome_uid") @db.Uuid
  eventId    String @map("event_id") @db.Uuid
  event      Event  @relation(fields: [eventId], references: [id])

  keyDiscussions     String? @map("key_discussions") @db.Text
  agreementsReached  String? @map("agreements_reached") @db.Text
  actionPoints       String? @map("action_points") @db.Text
  objectivesAchieved String? @map("objectives_achieved") @db.Text
  recommendations    String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([eventId], map: "idx_event_outcomes_event")
  @@map("event_outcomes")
}

// Add to your prisma/schema.prisma

model VisitType {
  id          String  @id @default(uuid()) @db.Uuid
  typeName    String  @unique @map("type_name") @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  visits Visit[]

  @@index([typeName], map: "idx_visit_types_name")
  @@map("visit_types")
}

model VisitCategory {
  id           String  @id @default(uuid()) @db.Uuid
  categoryName String  @unique @map("category_name") @db.VarChar(50)
  description  String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  visits Visit[]

  @@map("visit_categories")
}

model Visit {
  id       String @id @default(uuid()) @db.Uuid
  visitUid String @unique @default(uuid()) @map("visit_uid") @db.Uuid
  recordId String @unique @map("record_id") @db.VarChar(50)
  title    String @db.VarChar(255)

  visitTypeId String    @map("visit_type_id") @db.Uuid
  visitType   VisitType @relation(fields: [visitTypeId], references: [id])

  visitCategoryId String        @map("visit_category_id") @db.Uuid
  visitCategory   VisitCategory @relation(fields: [visitCategoryId], references: [id])

  visitDate DateTime @map("visit_date") @db.Date

  hostOrganization     String  @map("host_organization") @db.VarChar(255)
  visitingOrganization String  @map("visiting_organization") @db.VarChar(255)
  visitLocation        String? @map("visit_location") @db.VarChar(255)

  purpose String? @db.Text

  focalPersonId String @map("focal_person_id") @db.Uuid
  focalPerson   User   @relation("VisitFocalPerson", fields: [focalPersonId], references: [id])

  partnerId String? @map("partner_id") @db.Uuid
  // partner   Partner? @relation(fields: [partnerId], references: [id])

  status String @default("Planned") @db.VarChar(50)

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("VisitCreator", fields: [createdBy], references: [id])

  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewer    User?     @relation("VisitReviewer", fields: [reviewedBy], references: [id])
  reviewNotes String?   @map("review_notes") @db.Text
  reviewDate  DateTime? @map("review_date")

  verifiedBy        String?   @map("verified_by") @db.Uuid
  verifier          User?     @relation("VisitVerifier", fields: [verifiedBy], references: [id])
  verificationNotes String?   @map("verification_notes") @db.Text
  verificationDate  DateTime? @map("verification_date")
  verifiedStatus    String    @default("pending") @map("verified_status") @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  delegates VisitDelegationList[]
  outcomes  VisitOutcome[]

  @@index([recordId], map: "idx_visits_record_id")
  @@index([title], map: "idx_visits_title")
  @@index([visitDate], map: "idx_visits_date")
  @@index([visitTypeId], map: "idx_visits_type")
  @@index([visitCategoryId], map: "idx_visits_category")
  @@index([partnerId], map: "idx_visits_partner")
  @@index([status], map: "idx_visits_status")
  @@index([hostOrganization], map: "idx_visits_host")
  @@index([visitingOrganization], map: "idx_visits_visiting")
  @@index([focalPersonId], map: "idx_visits_focal_person")
  @@index([createdBy], map: "idx_visits_creator")
  @@map("visits")
}

model VisitDelegationList {
  id          String @id @default(uuid()) @db.Uuid
  delegateUid String @unique @default(uuid()) @map("delegate_uid") @db.Uuid

  visitId String @map("visit_id") @db.Uuid
  visit   Visit  @relation(fields: [visitId], references: [id])

  fullName         String  @map("full_name") @db.VarChar(255)
  position         String? @db.VarChar(255)
  organizationName String  @map("organization_name") @db.VarChar(255)
  country          String? @db.VarChar(100)
  email            String  @db.VarChar(255)
  phoneNumber      String? @map("phone_number") @db.VarChar(50)
  status           String  @default("Pending") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([visitId], map: "idx_visit_delegates_visit")
  @@index([organizationName], map: "idx_visit_delegates_org")
  @@index([status], map: "idx_visit_delegates_status")
  @@map("visit_delegation_list")
}

model VisitOutcome {
  id         String @id @default(uuid()) @db.Uuid
  outcomeUid String @unique @default(uuid()) @map("outcome_uid") @db.Uuid

  visitId String @map("visit_id") @db.Uuid
  visit   Visit  @relation(fields: [visitId], references: [id])

  keyTopicsDiscussed      String? @map("key_topics_discussed") @db.Text
  opportunitiesIdentified String? @map("opportunities_identified") @db.Text
  agreementsReached       String? @map("agreements_reached") @db.Text
  followUpActions         String? @map("follow_up_actions") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([visitId], map: "idx_visit_outcomes_visit")
  @@map("visit_outcomes")
}

//here opportunity schema

model OpportunityCategory {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  opportunities PartnerOpportunity[]

  @@map("opportunity_categories")
}

model StrategicImportanceLevel {
  id          String  @id @default(uuid()) @db.Uuid
  levelName   String  @unique @map("level_name") @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  opportunities PartnerOpportunity[]

  @@map("strategic_importance_levels")
}

model OpportunitySource {
  id          String  @id @default(uuid()) @db.Uuid
  sourceName  String  @unique @map("source_name") @db.VarChar(100)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  opportunities PartnerOpportunity[]

  @@map("opportunity_sources")
}

model PartnerOpportunity {
  id             String   @id @default(uuid()) @db.Uuid
  opportunityUid String   @unique @default(uuid()) @map("opportunity_uid") @db.Uuid
  title          String   @db.VarChar(255)
  dateIdentified DateTime @map("date_identified") @db.Date

  // Partner information
  partnerId        String? @map("partner_id") @db.Uuid
  partnerName      String  @map("partner_name") @db.VarChar(255)
  partnerAcronym   String? @map("partner_acronym") @db.VarChar(50)
  organizationType String? @map("organization_type") @db.VarChar(100)
  country          String? @db.VarChar(100)
  region           String? @db.VarChar(100)
  city             String? @db.VarChar(100)
  website          String? @db.VarChar(255)

  contactPersonName String? @map("contact_person_name") @db.VarChar(255)
  contactPosition   String? @map("contact_position") @db.VarChar(255)
  contactEmail      String? @map("contact_email") @db.VarChar(255)
  contactPhone      String? @map("contact_phone") @db.VarChar(50)

  existingRelationship String? @map("existing_relationship") @db.VarChar(50)
  interestArea         String? @map("interest_area") @db.Text

  strategicImportanceLevelId String?                   @map("strategic_importance_level_id") @db.Uuid
  strategicImportanceLevel   StrategicImportanceLevel? @relation(fields: [strategicImportanceLevelId], references: [id])

  opportunityCategoryId String?              @map("opportunity_category_id") @db.Uuid
  opportunityCategory   OpportunityCategory? @relation(fields: [opportunityCategoryId], references: [id])

  opportunitySourceId String?            @map("opportunity_source_id") @db.Uuid
  opportunitySource   OpportunitySource? @relation(fields: [opportunitySourceId], references: [id])

  opportunityBackground     String? @map("opportunity_background") @db.Text
  opportunityDescription    String? @map("opportunity_description") @db.Text
  proposedCollaborationArea String? @map("proposed_collaboration_area") @db.Text
  expectedOutcome           String? @map("expected_outcome") @db.Text

  strategicAlignment String? @map("strategic_alignment") @db.Text // JSON array
  expectedBenefits   String? @map("expected_benefits") @db.Text // JSON array

  // Workflow tracking
  verificationNotes String? @map("verification_notes") @db.Text
  reviewNotes       String? @map("review_notes") @db.Text
  approvalNotes     String? @map("approval_notes") @db.Text

  screenedAt DateTime? @map("screened_at")
  verifiedAt DateTime? @map("verified_at")
  reviewedAt DateTime? @map("reviewed_at")
  approvedAt DateTime? @map("approved_at")

  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("OpportunityCreator", fields: [createdBy], references: [id])

  reviewedBy String? @map("reviewed_by") @db.Uuid
  reviewer   User?   @relation("OpportunityReviewer", fields: [reviewedBy], references: [id])

  verifiedBy String? @map("verified_by") @db.Uuid
  verifier   User?   @relation("OpportunityVerifier", fields: [verifiedBy], references: [id])

  status String @default("Draft") @db.VarChar(50)

  convertedToEntityType String? @map("converted_to_entity_type") @db.VarChar(50)
  convertedToEntityId   String? @map("converted_to_entity_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relationships
  // partner Partner? @relation(fields: [partnerId], references: [id])
  user                      User?                      @relation(fields: [userId], references: [id])
  userId                    String?                    @db.Uuid
  opportunityCommunications OpportunityCommunication[]
  engagements               Engagement[]

  @@index([opportunityUid], map: "idx_opportunity_uid")
  @@index([partnerId], map: "idx_opportunity_partner")
  @@index([partnerName], map: "idx_opportunity_partner_name")
  @@index([dateIdentified], map: "idx_opportunity_date")
  @@index([opportunityCategoryId], map: "idx_opportunity_category")
  @@index([strategicImportanceLevelId], map: "idx_opportunity_strategic_level")
  @@index([status], map: "idx_opportunity_status")
  @@index([createdBy], map: "idx_opportunity_creator")
  @@map("partner_opportunities")
}

//here engagement started 

model CommunicationType {
  id          String  @id @default(uuid()) @db.Uuid
  typeName    String  @unique @map("type_name") @db.VarChar(50)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  communications OpportunityCommunication[]

  @@index([typeName], map: "idx_comm_types_name")
  @@map("communication_types")
}

model OpportunityCommunication {
  id               String @id @default(uuid()) @db.Uuid
  communicationUid String @unique @default(uuid()) @map("communication_uid") @db.Uuid

  opportunityId String             @map("opportunity_id") @db.Uuid
  opportunity   PartnerOpportunity @relation(fields: [opportunityId], references: [id])

  communicationTypeId String            @map("communication_type_id") @db.Uuid
  communicationType   CommunicationType @relation(fields: [communicationTypeId], references: [id])

  emailSubject   String   @map("email_subject") @db.VarChar(255)
  emailRecipient String   @map("email_recipient") @db.VarChar(255)
  emailBody      String   @map("email_body") @db.Text
  sentDate       DateTime @map("sent_date")

  ccRecipients   String? @map("cc_recipients") @db.Text // JSON array
  bccRecipients  String? @map("bcc_recipients") @db.Text // JSON array
  hasAttachments Boolean @default(false) @map("has_attachments")

  sentBy String @map("sent_by") @db.Uuid
  sender User   @relation("CommunicationSender", fields: [sentBy], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?   @db.Uuid

  @@index([opportunityId], map: "idx_comm_opportunity")
  @@index([sentDate], map: "idx_comm_sent_date")
  @@index([communicationTypeId], map: "idx_comm_type")
  @@index([sentBy], map: "idx_comm_sender")
  @@map("opportunity_communications")
}

model EngagementType {
  id          String  @id @default(uuid()) @db.Uuid
  typeName    String  @unique @map("type_name") @db.VarChar(100)
  description String? @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  engagements Engagement[]

  @@index([typeName], map: "idx_engagement_types_name")
  @@map("engagement_types")
}

model Engagement {
  id            String @id @default(uuid()) @db.Uuid
  engagementUid String @unique @default(uuid()) @map("engagement_uid") @db.Uuid
  recordId      String @unique @map("record_id") @db.VarChar(50)

  opportunityId String             @map("opportunity_id") @db.Uuid
  opportunity   PartnerOpportunity @relation(fields: [opportunityId], references: [id])

  engagementTypeId String         @map("engagement_type_id") @db.Uuid
  engagementType   EngagementType @relation(fields: [engagementTypeId], references: [id])

  engagementDate DateTime  @map("engagement_date") @db.Date
  title          String    @db.VarChar(255)
  location       String?   @db.VarChar(255)
  startTime      DateTime? @map("start_time") @db.Time
  endTime        DateTime? @map("end_time") @db.Time

  // Discussion Summary
  keyPoints     String @map("key_points") @db.Text
  agreedActions String @map("agreed_actions") @db.Text
  nextSteps     String @map("next_steps") @db.Text

  // Follow-up Tracking
  followUpRequired Boolean   @default(false) @map("follow_up_required")
  followUpDate     DateTime? @map("follow_up_date") @db.Date
  followUpNotes    String?   @map("follow_up_notes") @db.Text

  status String @default("Draft") @db.VarChar(50)

  // Workflow
  createdBy String @map("created_by") @db.Uuid
  creator   User   @relation("EngagementCreator", fields: [createdBy], references: [id])

  approvedBy    String?   @map("approved_by") @db.Uuid
  approver      User?     @relation("EngagementApprover", fields: [approvedBy], references: [id])
  approvalNotes String?   @map("approval_notes") @db.Text
  approvalDate  DateTime? @map("approval_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  externalParticipants EngagementExternalParticipant[]
  eaiiRepresentatives  EngagementEaiiRepresentative[]
  user                 User?                           @relation(fields: [userId], references: [id])
  userId               String?                         @db.Uuid

  @@index([recordId], map: "idx_engagements_record_id")
  @@index([opportunityId], map: "idx_engagements_opportunity")
  @@index([engagementDate], map: "idx_engagements_date")
  @@index([engagementTypeId], map: "idx_engagements_type")
  @@index([status], map: "idx_engagements_status")
  @@index([createdBy], map: "idx_engagements_creator")
  @@map("engagements")
}

model EngagementExternalParticipant {
  id           String     @id @default(uuid()) @db.Uuid
  engagementId String     @map("engagement_id") @db.Uuid
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  fullName         String  @map("full_name") @db.VarChar(255)
  organizationName String  @map("organization_name") @db.VarChar(255)
  position         String? @db.VarChar(255)
  email            String? @db.VarChar(255)
  phoneNumber      String? @map("phone_number") @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([engagementId], map: "idx_eng_ext_part_engagement")
  @@index([organizationName], map: "idx_eng_ext_part_org")
  @@map("engagement_external_participants")
}

model EngagementEaiiRepresentative {
  id           String     @id @default(uuid()) @db.Uuid
  engagementId String     @map("engagement_id") @db.Uuid
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  userId String? @map("user_id") @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  fullName String  @map("full_name") @db.VarChar(255)
  division String  @db.VarChar(100)
  email    String  @db.VarChar(255)
  role     String? @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([engagementId], map: "idx_eng_eaii_rep_engagement")
  @@index([userId], map: "idx_eng_eaii_rep_user")
  @@map("engagement_eaii_representatives")
}
